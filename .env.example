# Base URL of the deployed FastAPI ML service.
VITE_API_BASE_URL=https://prosensia-ml-api.onrender.com

# API key sent as the `x-api-key` header on every protected request.
# Never commit your real key — copy this file to `.env` and fill it in locally,
# and set it as an environment variable in your deployment platform (e.g. Vercel).
VITE_API_KEY=your_api_key_here
